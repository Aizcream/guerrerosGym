---
import './Ubicacion.css';
---

<section class="ubicacion-section" id="ubicacion">
  <div class="ubicacion-container">
    <div class="ubicacion-header">
      <div class="ubicacion-tag">
        <span class="hero-tag-dot"></span>
        UBICACIÓN
      </div>
      <h2 class="ubicacion-title">VISÍTANOS EN <span>NUESTRA SEDE</span></h2>
      <p class="ubicacion-desc">
        Estamos donde puedas llegar fácil, entrenar y volver a tu día. Encuéntranos, revisa el horario y traza tu ruta directo desde Google Maps.
      </p>
    </div>

    <div class="map-card">
      <iframe
        src="https://maps.google.com/maps?q=GUERREROS+GYM,+Av.+4A+%238-06,+Prados+del+Este,+C%C3%BAcuta,+Norte+de+Santander&ll=7.9110667,-72.4698574&z=17&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación Guerreros Gym — Av. 4A #8-06, Prados del Este, Cúcuta"
      ></iframe>
    </div>
  </div>
</section>
