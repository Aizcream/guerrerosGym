---
import './WhyUs.css';
import { Image } from 'astro:assets';
import whyusImg from '../assets/images/whyus.png';
---

<section class="whyus-section">
  <div class="whyus-container">
    <!-- Left: Image -->
    <div class="whyus-image-container">
      <Image
        src={whyusImg}
        alt="Why Us Guerreros Gym"
        class="whyus-image"
      />
      <div class="whyus-gradient-overlay"></div>
    </div>

    <!-- Center: Text -->
    <div class="whyus-text-container">
      <h2 class="whyus-title">
        ¿POR QUÉ
        <br />
        ELEGIRNOS?
      </h2>
      <p class="whyus-desc">
        No somos solo un gimnasio, somos una comunidad que te lleva más
        allá.
      </p>
    </div>

    <!-- Right: Stats Grid -->
    <div class="whyus-stats-container">
      <div class="stat-item">
        <span class="stat-number">300+</span>
        <span class="stat-label">GUERREROS ACTIVOS</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">15+</span>
        <span class="stat-label">ENTRENADORES EXPERTOS</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">100%</span>
        <span class="stat-label">ENFOQUE EN RESULTADOS</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">
          5 <span class="stat-star">★</span>
        </span>
        <span class="stat-label">CALIFICACIÓN EN GOOGLE</span>
      </div>
    </div>
  </div>
</section>
